<body>

<header>
    <h1>Projeto Agrinho 2026</h1>
    <p>Campo e Cidade: Juntos por um Futuro Sustentável</p>
    <a href="sobre" class="botao">Conheça o Projeto</a>
</header>

<nav>
    <a href="sobre">Sobre</a>
